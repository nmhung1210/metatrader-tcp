{
  "name": "metatrader",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/unzip-mt5.js && pip install nats-py pyinstaller unflatten uuid sentry_sdk",
    "compile": "node scripts/compile.js",
    "build": "docker compose build",
    "push": "docker compose push",
    "dev": "nodemon --exec python terminal/main.py",
    "up": "docker compose -p fxterminal-tcp-v2 -f infra/docker-compose.yml up -d --remove-orphans",
    "down": "docker compose -p fxterminal-tcp-v2 -f infra/docker-compose.yml down"
  },
